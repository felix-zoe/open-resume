{
  "name": "open-resume",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:s0": "playwright test --grep @s0",
    "test:e2e:s1": "playwright test --grep @s1",
    "check:static": "node scripts/check-static.mjs",
    "verify": "npm run check:static && npm run test:unit:run && npm run build && npm run test:e2e",
    "verify:s0": "npm run check:static && npm run test:unit:run && npm run build && npm run test:e2e:s0",
    "verify:s1": "npm run check:static && npm run test:unit:run && npm run build && npm run test:e2e:s1",
    "cf:dev": "wrangler pages dev dev/api-only --compatibility-date=2024-09-23 --port 8787",
    "deploy": "wrangler pages deploy dist",
    "d1:init:local": "wrangler d1 execute open-resume-db --local --file=./docs/schema.sql",
    "d1:init:remote": "wrangler d1 execute open-resume-db --remote --file=./docs/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "lucide-vue-next": "^0.453.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^4.20241018.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.6",
    "wrangler": "^3.80.0"
  }
}
