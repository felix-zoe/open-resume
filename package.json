{
  "name": "open-resume",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev --compatibility-date=2024-09-23 --d1=DB=open-resume-db --r2=BUCKET=open-resume-assets",
    "d1:init:local": "wrangler d1 execute open-resume-db --local --file=./docs/schema.sql",
    "d1:init:remote": "wrangler d1 execute open-resume-db --remote --file=./docs/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "lucide-vue-next": "^0.453.0",
    "pinia": "^2.2.4",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241018.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vue-tsc": "^2.1.6",
    "wrangler": "^3.80.0"
  }
}
