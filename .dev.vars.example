# 本地开发环境变量（复制为 .dev.vars 后填写；该文件已被 .gitignore 忽略）
#
# 用法：
#   1. 复制本文件：cp .dev.vars.example .dev.vars
#   2. 填入真实值
#   3. npm run cf:dev 会自动读取 .dev.vars
#
# 生产环境不要用本文件，改用 Secret 注入：
#   npx wrangler secret put JWT_SECRET
#   npx wrangler pages secret put APP_ORIGIN

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------

# 签发/校验登录 Token（HS256）。缺失时服务端直接失败（50003），不会回退默认值。
# 生成一个强随机值：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# 允许跨域访问 /api 的来源，逗号分隔。
# 本地 vite dev 需要它（5173 → 8787）；生产同源部署可留空（留空 = 不放行任何跨域来源）。
APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------

# 迁移脚本使用的 D1 库名，默认 open-resume-db
# D1_DATABASE_NAME=open-resume-db
